/* Acknowledgement of Country */
"onboarding.acknowledgement_title" = "Reconocimiento del Territorio (Acknowledgement of Country)";
"onboarding.acknowledgement_body" = "Reconocemos a los Custodios Tradicionales (Traditional Owners) de las tierras y las aguas de toda Australia, y su vínculo permanente con el Territorio (Country), la cultura y la comunidad. Presentamos nuestros respetos a los Mayores (Elders) del pasado y del presente.";
"onboarding.acknowledgement_note" = "Los pueblos aborígenes y del Estrecho de Torres han cuidado este continente durante más de 60.000 años, en cientos de naciones con sus propias lenguas y leyes. Escucharás un reconocimiento como este al comenzar reuniones, clases y eventos en toda Australia. Cualquier persona puede ofrecerlo.";
"onboarding.acknowledgement_learn" = "Aprende más en Historia y cultura";

