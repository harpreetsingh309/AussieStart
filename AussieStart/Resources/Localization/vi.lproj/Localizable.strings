/* Acknowledgement of Country */
"onboarding.acknowledgement_title" = "Lời ghi nhận Đất Mẹ (Acknowledgement of Country)";
"onboarding.acknowledgement_body" = "Chúng tôi ghi nhận những Chủ Nhân Truyền Thống (Traditional Owners) của các vùng đất và vùng nước trên khắp nước Úc, cùng mối gắn bó bền bỉ của họ với Đất Mẹ (Country — đất, nước, bầu trời và mọi mối quan hệ gắn với một nơi chốn), với văn hoá và cộng đồng. Chúng tôi bày tỏ lòng kính trọng với các Bậc Trưởng Thượng (Elders) trong quá khứ và hiện tại.";
"onboarding.acknowledgement_note" = "Người Thổ dân (Aboriginal) và người dân đảo eo biển Torres đã chăm sóc lục địa này hơn 60.000 năm, qua hàng trăm dân tộc với ngôn ngữ và luật lệ riêng. Bạn sẽ nghe một lời ghi nhận như thế này vào đầu các cuộc họp, buổi học và sự kiện trên khắp nước Úc. Bất kỳ ai cũng có thể nói lời ghi nhận ấy.";
"onboarding.acknowledgement_learn" = "Tìm hiểu thêm trong mục Lịch sử & Văn hoá";

