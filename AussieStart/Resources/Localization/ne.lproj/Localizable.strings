"onboarding.acknowledgement_title" = "भूमिप्रतिको सम्मान (Acknowledgement of Country)";
"onboarding.acknowledgement_body" = "हामी अस्ट्रेलियाभरिका भूमि र जलका परम्परागत भूमिधनी (Traditional Owners) प्रति सम्मान व्यक्त गर्दछौँ, र यस भूमि, जल, आकाश तथा तिनसँग जोडिएका सम्बन्धहरू (Country), संस्कृति एवं समुदायसँगको उहाँहरूको निरन्तर नाताको कदर गर्दछौँ। विगत र वर्तमानका आदरणीय अग्रजहरू (Elders) प्रति हामी नतमस्तक छौँ।";
"onboarding.acknowledgement_note" = "Aboriginal र Torres Strait Islander जनजातिहरूले ६०,००० भन्दा बढी वर्षदेखि यस महादेशको हेरचाह गर्दै आएका छन् — आ-आफ्नै भाषा र कानुन भएका सयौँ राष्ट्रहरूमा फैलिएर। अस्ट्रेलियाभरि बैठक, कक्षा र कार्यक्रमको सुरुमा तपाईंले यस्तै सम्मानका शब्दहरू सुन्नुहुनेछ। जो कसैले पनि यसो भन्न सक्छ।";
"onboarding.acknowledgement_learn" = "इतिहास र संस्कृतिमा थप जान्नुहोस्";

